-- Platform Logic
local function RemovePlatform()
    if Platform then
        Platform:Destroy()
        Platform = nil
    end
end

FloatBtn.MouseButton1Click:Connect(function()
    FloatEnabled = not FloatEnabled
    if FloatEnabled then
        FloatBtn.Text = "Plattform: AN"
        FloatBtn.BackgroundColor3 = Color3.fromRGB(45, 160, 75)
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            FloatY = char.HumanoidRootPart.Position.Y - 3.5
            
            Platform = Instance.new("Part")
            Platform.Size = Vector3.new(9, 1, 9)
            Platform.Anchored = true
            Platform.CanCollide = true
            Platform.Transparency = 1
            Platform.Parent = workspace
        end
    else
        FloatBtn.Text = "Plattform: AUS"
        FloatBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        RemovePlatform()
    end
end)

UpBtn.MouseButton1Click:Connect(function()
    if FloatEnabled then FloatY = FloatY + 2.5 end
end)

DownBtn.MouseButton1Click:Connect(function()
    if FloatEnabled then FloatY = FloatY - 2.5 end
end)

-- Keybind Assignment Logic
UpKeyBtn.MouseButton1Click:Connect(function()
    BindingUp = true
    BindingDown = false
    UpKeyBtn.Text = "[...]"
    DownKeyBtn.Text = "Taste: " .. DownKey.Name
end)

DownKeyBtn.MouseButton1Click:Connect(function()
    BindingDown = true
    BindingUp = false
    DownKeyBtn.Text = "[...]"
    UpKeyBtn.Text = "Taste: " .. UpKey.Name
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Handle Key Rebinding
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if BindingUp then
            UpKey = input.KeyCode
            UpKeyBtn.Text = "Taste: " .. UpKey.Name
            BindingUp = false
            return
        elseif BindingDown then
            DownKey = input.KeyCode
            DownKeyBtn.Text = "Taste: " .. DownKey.Name
            BindingDown = false
            return
        end
    end

    -- Handle Float Height Controls via Keys
    if not gameProcessed and FloatEnabled then
        if input.KeyCode == UpKey then
            FloatY = FloatY + 2.5
        elseif input.KeyCode == DownKey then
            FloatY = FloatY - 2.5
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if FloatEnabled and Platform then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPos = char.HumanoidRootPart.Position
            Platform.CFrame = CFrame.new(rootPos.X, FloatY, rootPos.Z)
        end
    end
end)
